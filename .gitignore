.gradle/
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
.project
.classpath
.kotlin
build.bat
run.bat

/.vscode/
/run/
/.idea/
/bin/
*.iml
.DS_Store

# Web server images directory (volume bind)
/web/images/*
!/web/images/.gitkeep
